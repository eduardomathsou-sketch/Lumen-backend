# Local development. On Vercel, enter variables in Settings > Environment Variables.
LUMEN_DEBUG=false
AUTO_CREATE_TABLES=false
SEED_CATALOG=false

# Neon Connect: pooled URL for runtime, direct URL for migrations/imports.
# Keep the full URL, including sslmode=require and channel_binding if provided.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# Exact frontend origin, without /api/v1 or a trailing slash.
CORS_ORIGINS=https://SEU-FRONTEND.vercel.app

# Checkout Transparente > API de Orders. Production token means real charges.
PAYMENT_PROVIDER=mercadopago_orders
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Orders webhook URL is configured in the Mercado Pago dashboard.
# MERCADO_PAGO_NOTIFICATION_URL is only used by the legacy Payments adapter.
PAYMENT_ADMIN_TOKEN=
# Generate distinct random values for these two tokens.
CRON_SECRET=
MAINTENANCE_MAX_ORDERS=10

# Example only: replace with the store's actual flat shipping price and deadline.
SHIPPING_FLAT_RATE_CENTS=1500
SHIPPING_LABEL=Entrega padrão
SHIPPING_DAYS=7
ORDER_TTL_MINUTES=30
