# Local development. On Vercel, enter variables in Settings > Environment Variables.
LUMEN_DEBUG=false
AUTO_CREATE_TABLES=false
SEED_CATALOG=false

# Neon Connect: pooled URL for runtime, direct URL for migrations/imports.
# Keep the full URL, including sslmode=require and channel_binding if provided.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# Exact frontend origin, without /api/v1 or a trailing slash.
CORS_ORIGINS=https://SEU-FRONTEND.vercel.app

# Docs interativas (/docs): ligadas no desenvolvimento, desligadas na Vercel por padrão.
# EXPOSE_DOCS=true
# Na Vercel o IP real da cliente vem em x-real-ip (preenchido pela própria Vercel).
# CLIENT_IP_HEADER=x-real-ip

# Enquanto não houver conta Mercado Pago, use o sandbox com um segredo forte (32+ caracteres):
# PAYMENT_PROVIDER=sandbox
# PAYMENT_WEBHOOK_SECRET=gere-com-python-secrets-token_urlsafe-32
# Checkout Transparente > API de Orders. Production token means real charges.
PAYMENT_PROVIDER=mercadopago_orders
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Orders webhook URL is configured in the Mercado Pago dashboard.
# MERCADO_PAGO_NOTIFICATION_URL is only used by the legacy Payments adapter.
PAYMENT_ADMIN_TOKEN=
# Generate distinct random values for these two tokens.
CRON_SECRET=
# Required: configure an external scheduler every minute; see DEPLOY_VERCEL.md.
MAINTENANCE_MAX_ORDERS=10

# Example only: replace with the store's actual flat shipping price and deadline.
SHIPPING_FLAT_RATE_CENTS=1500
SHIPPING_LABEL=Entrega padrão
SHIPPING_DAYS=7
# For PAC/SEDEX instead of flat shipping, set SHIPPING_PROVIDER=melhorenvio.
SHIPPING_PROVIDER=flat
SHIPPING_ORIGIN_POSTAL_CODE=59022080
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_USER_AGENT=
MELHOR_ENVIO_SANDBOX=false
ORDER_TTL_MINUTES=30

# Identificação da loja (Decreto 7.962/2013): aparece nas políticas e nos e-mails.
STORE_NAME=Lumen
STORE_LEGAL_NAME=
STORE_DOCUMENT=
STORE_ADDRESS=
STORE_CONTACT_EMAIL=
# Encarregado(a) de dados (LGPD). Vazio = usa STORE_CONTACT_EMAIL.
DPO_EMAIL=

# Links nos e-mails: endereço público da API (descadastro) e tela de nova senha do app ({token}).
API_PUBLIC_URL=
PASSWORD_RESET_URL=

# E-mails: console (desenvolvimento) ou smtp (produção: Brevo, Resend, SES...).
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Lembrete de sacola (só contas que aceitaram comunicações). 0 desliga.
CART_REMINDER_HOURS=24

# Código de acesso (sessão): validade para clientes (dias) e para a administração (horas),
# e quantos aparelhos uma conta pode manter conectados ao mesmo tempo.
SESSION_DAYS=7
ADMIN_SESSION_HOURS=12
MAX_SESSIONS_PER_USER=10


# Pedidos novos por IP em 15 min e unidades de cada produto por pedido (contra reserva de estoque sem pagar).
ORDER_IP_LIMIT=30
MAX_UNITS_PER_ITEM=10
# Códigos de cupom inexistentes por IP em 15 min (contra chute de cupons).
COUPON_ATTEMPT_LIMIT=10